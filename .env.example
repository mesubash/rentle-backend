# Database
DB_URL=jdbc:postgresql://localhost:5433/rentle
DB_USER=rentle
DB_PASSWORD=dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT — RSA keys in PEM (PKCS#8 private, X.509 public). Leave blank in dev to
# auto-generate an ephemeral pair at startup.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Storage: local | cloudinary
RENTLE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS: logging | sparrow
RENTLE_SMS=logging
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=Rentle
